# Liste blanche : tout est ignoré sauf ce qui est listé ici.
/*
!/.gitignore
!/README.md
!/CLEAR_HANDOFF.md
!/RUN_STATE.md
!/STEP8_HANDOFF.md
!/hooks/
!/scripts/
!/work/

/scripts/*
!/scripts/*.py
!/scripts/*.java
!/scripts/*.c

/work/*
!/work/step*.md
!/work/step*.json
!/work/*_verification.json
!/work/*_verification.console.json
!/work/external_references.json
!/work/thumb_special_pair_approved_returns.json
!/work/thumb_special_pair_c_review.json
!/work/thumb_special_pair_preflight.json
!/work/thumb_special_pair_probe_differences.json
!/work/thumb_special_pair_independent_review.md

# Filet de sécurité : ces motifs l'emportent sur la liste blanche.
*_private/
external/
work/archives/
work/ghidra*/
work/repo/
work/repo.tgz
work/rom/
__pycache__/
*.pyc
*.gba
*.elf
*.png
*.jpg
*.jpeg
*.sav
*.ss[0-9]
*.so
*.gpr
*.rep
*.deb
*.sqlite
